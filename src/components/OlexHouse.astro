---
// olex's doghouse as pixel art, generated on a 32x28 grid and drawn at 2x so its pixels match his
const W = 32, H = 28;
const COLORS: Record<string, string> = {
  R: '#bd5d3a', // roof shingles
  r: '#9c4a2d', // shingle shadow rows
  e: '#6e3220', // roof edge and eave
  W: '#a76d46', // wall planks
  w: '#8a5332', // plank shadow rows
  o: '#5e3520', // wall edges
  f: '#4a2a1a', // door frame
  D: '#1a0f0a', // doorway
};

const grid: string[][] = Array.from({ length: H }, () => Array(W).fill('.'));
const set = (x: number, y: number, c: string) => {
  if (x >= 0 && x < W && y >= 0 && y < H) grid[y][x] = c;
};

// roof: a triangle with shingle rows, an outlined edge, and an overhanging eave
const ROOF = 12;
for (let y = 0; y < ROOF; y++) {
  const half = Math.round(2 + y * 1.25);
  const x1 = 16 - half, x2 = 15 + half;
  for (let x = x1; x <= x2; x++) set(x, y, x === x1 || x === x2 || y === ROOF - 1 ? 'e' : Math.floor(y / 2) % 2 ? 'r' : 'R');
}

// walls: planks under the eave
for (let y = ROOF; y < H; y++)
  for (let x = 3; x <= 28; x++) set(x, y, x === 3 || x === 28 ? 'o' : Math.floor((y - ROOF) / 2) % 2 ? 'w' : 'W');

// arched doorway with a frame
const door = (y: number): [number, number] | null => {
  if (y < 16) return null;
  if (y === 16) return [13, 18];
  if (y === 17) return [12, 19];
  return [11, 20];
};
for (let y = 15; y < H; y++) {
  const d = door(y) ?? (y === 15 ? [13, 18] as [number, number] : null);
  if (!d) continue;
  for (let x = d[0] - 1; x <= d[1] + 1; x++) if (grid[y][x] !== 'D') set(x, y, 'f');
  if (door(y)) for (let x = d[0]; x <= d[1]; x++) set(x, y, 'D');
}

const pixels = grid.flatMap((row, y) => row.flatMap((ch, x) => (COLORS[ch] ? [{ x, y, fill: COLORS[ch] }] : [])));
---
<button id="olex-house" class="olex-house" type="button" aria-label="call olex out">
  <svg viewBox={`0 0 ${W} ${H}`} width={W * 2} height={H * 2} shape-rendering="crispEdges" aria-hidden="true">
    {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
  </svg>
</button>

<style>
  .olex-house {
    position: absolute;
    right: 24px;
    bottom: 100%;
    z-index: 4; /* behind olex as he walks past; olex's controller adds .in-front while he goes in or out */
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    line-height: 0;
    cursor: pointer;
  }
  .olex-house svg { display: block; }
  .olex-house:global(.in-front) { z-index: 6; }
</style>
