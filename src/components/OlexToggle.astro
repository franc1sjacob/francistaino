<button id="olex-toggle" class="olex-toggle" type="button" aria-pressed="true" aria-label="send olex home">🐾</button>

<style>
  .olex-toggle {
    background: transparent;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    filter: grayscale(1);
    opacity: 0.6;
  }
  .olex-toggle:hover { opacity: 1; }
  .olex-toggle[aria-pressed="true"] { filter: none; opacity: 1; }
</style>
