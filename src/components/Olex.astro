---
---
<div id="olex-layer" transition:persist aria-hidden="false">
  <canvas id="olex" role="img" aria-label="Olex the dog"></canvas>
  <div id="olex-tag" class="olex-tag" hidden>olex<span id="olex-tag-counts" class="olex-tag-counts"></span></div>
  <div id="olex-menu" class="olex-menu" role="menu" aria-label="olex commands" hidden></div>
</div>

<style>
  #olex-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0;
    /* his canvas is wider than he is; never let it widen the page on phones */
    overflow-x: clip;
    pointer-events: none;
    z-index: 5;
  }
  #olex {
    position: absolute;
    left: 0;
    top: 0;
    image-rendering: pixelated;
    pointer-events: none;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  #olex.carried { cursor: grabbing; }
  .olex-tag {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 11px;
    color: var(--accent);
    white-space: nowrap;
    pointer-events: none;
  }
  .olex-tag-counts { color: var(--dim); }
  :global(.olex-heart) {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-size: 14px;
    pointer-events: none;
    animation: olex-rise 0.9s ease-out forwards;
  }
  :global(.olex-z) {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--dim);
    font-size: 12px;
    pointer-events: none;
    animation: olex-drift 1.8s ease-out forwards;
  }
  @keyframes olex-drift {
    to { translate: 10px -30px; opacity: 0; }
  }
  :global(.olex-ball) {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    image-rendering: pixelated;
    pointer-events: none;
  }
  /* on touch screens the ball is picked up directly: a bigger invisible touch target, and no page scroll from it */
  :global(.olex-ball.grabbable) {
    box-sizing: content-box; /* the site defaults to border-box, which would squash the ball into its padding */
    padding: 15px;
    margin: -15px;
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
  }
  :global(.olex-bone) {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 10px;
    image-rendering: pixelated;
    pointer-events: none;
  }
  .olex-menu {
    position: fixed;
    z-index: 50;
    min-width: 150px;
    padding: 6px 0;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 13px;
    pointer-events: auto;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }
  .olex-menu :global(.olex-menu-title) {
    padding: 2px 12px 6px;
    color: var(--accent);
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: 4px;
  }
  .olex-menu :global(button) {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    padding: 3px 12px;
    font: inherit;
    color: var(--text);
    cursor: pointer;
  }
  .olex-menu :global(button:hover),
  .olex-menu :global(button:focus-visible) {
    color: var(--accent);
    outline: none;
    background: var(--border-soft);
  }
  @keyframes olex-rise {
    to { translate: 0 -28px; opacity: 0; }
  }
</style>

<script>
  import { start } from '../olex/index';
  start();
</script>
