---
---
<div id="olex-layer" transition:persist aria-hidden="false">
  <canvas id="olex" role="img" aria-label="Olex the dog"></canvas>
  <div id="olex-tag" class="olex-tag" hidden>olex</div>
</div>

<style>
  #olex-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 5;
  }
  #olex {
    position: absolute;
    left: 0;
    top: 0;
    image-rendering: pixelated;
    pointer-events: none;
    cursor: grab;
    touch-action: none;
  }
  #olex.carried { cursor: grabbing; }
  .olex-tag {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 11px;
    color: var(--accent);
    white-space: nowrap;
    pointer-events: none;
  }
  :global(.olex-heart) {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-size: 14px;
    pointer-events: none;
    animation: olex-rise 0.9s ease-out forwards;
  }
  :global(.olex-z) {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--dim);
    font-size: 12px;
    pointer-events: none;
    animation: olex-drift 1.8s ease-out forwards;
  }
  @keyframes olex-drift {
    to { translate: 10px -30px; opacity: 0; }
  }
  @keyframes olex-rise {
    to { translate: 0 -28px; opacity: 0; }
  }
</style>

<script>
  import { start } from '../olex/index';
  start();
</script>
