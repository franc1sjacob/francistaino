---
const year = new Date().getFullYear();
const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
---

<footer class="site-footer">
  <div class="row">
    <span>© {year} Francis Taino</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>last updated {lastUpdated}</span>
  </div>
  <span class="sep desktop-only" aria-hidden="true">·</span>
  <div class="row">
    <a href="https://github.com/franc1sjacob/francistaino" target="_blank" rel="noopener">view source ↗</a>
    <span class="sep" aria-hidden="true">·</span>
    <a href="/rss.xml">rss</a>
  </div>
</footer>

<style>
  .site-footer {
    max-width: 640px;
    margin: 32px auto 0;
    width: 100%;
    border-top: 1px solid var(--border-soft);
    padding: 20px 24px;
    color: var(--dim);
    font-size: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 8px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-footer a {
    color: var(--dim);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .sep { color: var(--vdim); }

  @media (max-width: 520px) {
    .site-footer {
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .desktop-only { display: none; }
  }
</style>
